# Lightweight CPU-only image for generating Linux reference outputs.
# Used for cross-platform parity validation.
#
# Build:
#   docker build -f docker/Dockerfile.reference -t alphafold3-reference .
#
# Run:
#   mkdir -p reference_outputs
#   docker run --rm -v $(pwd)/reference_outputs:/output alphafold3-reference
#
# The generated .npz files will have platform=Linux metadata for use in
# cross-platform validation tests on macOS.

FROM python:3.12-slim-bookworm

# Install build dependencies for C++ extensions and HMMER.
# * git is required for pyproject.toml toolchain's use of CMakeLists.txt.
# * gcc, g++, make are required for compiling AlphaFold 3 C++ extensions and HMMER.
# * cmake, ninja-build are required for scikit-build-core.
# * zlib is a required dependency of AlphaFold 3.
# * wget, patch are required for building HMMER from source.
RUN apt-get update --quiet \
    && apt-get install --yes --quiet --no-install-recommends \
        git \
        gcc \
        g++ \
        make \
        cmake \
        ninja-build \
        zlib1g-dev \
        wget \
        patch \
    && rm -rf /var/lib/apt/lists/*

# Install HMMER with --seq_limit patch for full pipeline testing.
# Download, verify checksum, and build from source.
RUN mkdir /hmmer_build /hmmer ; \
    wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz --directory-prefix /hmmer_build ; \
    (cd /hmmer_build && echo "ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3 hmmer-3.4.tar.gz" | sha256sum --check) && \
    (cd /hmmer_build && tar zxf hmmer-3.4.tar.gz && rm hmmer-3.4.tar.gz)

# Apply the --seq_limit patch to HMMER.
COPY docker/jackhmmer_seq_limit.patch /hmmer_build/
RUN (cd /hmmer_build && patch -p0 < jackhmmer_seq_limit.patch)

# Build HMMER.
RUN (cd /hmmer_build/hmmer-3.4 && ./configure --prefix /hmmer) ; \
    (cd /hmmer_build/hmmer-3.4 && make -j) ; \
    (cd /hmmer_build/hmmer-3.4 && make install) ; \
    (cd /hmmer_build/hmmer-3.4/easel && make install) ; \
    rm -R /hmmer_build

# Install uv from the official repository. The version is pinned for
# reproducibility (same version as main Dockerfile).
COPY --from=ghcr.io/astral-sh/uv:0.9.24 /uv /uvx /bin/

# UV_COMPILE_BYTECODE=1 speeds up future container starts.
# UV_PROJECT_ENVIRONMENT explicitly sets the virtual environment location.
ENV UV_COMPILE_BYTECODE=1
ENV UV_PROJECT_ENVIRONMENT=/alphafold3_venv
RUN uv venv $UV_PROJECT_ENVIRONMENT

ENV PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

# Copy the AlphaFold 3 source code from the local machine to the container.
WORKDIR /app/alphafold3

# Copy dependency files first for better layer caching.
COPY pyproject.toml uv.lock ./

# Copy source code for C++ extension compilation.
COPY src/ ./src/
COPY CMakeLists.txt ./

# Copy license files and README (required by pyproject.toml).
COPY LICENSE OUTPUT_TERMS_OF_USE.md WEIGHTS_PROHIBITED_USE_POLICY.md WEIGHTS_TERMS_OF_USE.md README.md ./

# Copy test fixtures needed for reference generation.
COPY tests/fixtures/test_sequence.fasta ./tests/fixtures/
COPY tests/fixtures/minimal_test_db.fasta ./tests/fixtures/

# Copy reference generation script.
COPY scripts/generate_reference_outputs.py ./scripts/

# Install dependencies and build C++ extensions.
# --frozen: do not update the lockfile during build.
# --all-groups: install development/test dependencies.
# --no-editable: install as a static package.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-groups --no-editable

# Default output directory for reference files.
ENV OUTPUT_DIR=/output

# Generate reference outputs on container startup.
# --force: generate on Linux without prompting (this IS the canonical platform).
ENTRYPOINT ["python", "scripts/generate_reference_outputs.py", "--force"]
CMD ["--output", "/output"]
